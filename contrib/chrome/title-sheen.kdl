// title sheen — chrome
//
// Hand-written, unlike contrib/shaders: those are generated from
// contrib/shadertoy.html, and the toy previews a pane's *contents*. A frame is
// a different rect and the toy has no frame to show.
//
// Drop this into ~/.config/sl0ppty/config.kdl (a running session picks it up
// when you save), or point $SL0PPTY_CONFIG at this file. To hang it off a pane
// state instead of every pane, put the same pass inside one:
//
//     states { bell { ... } }
//
// The top rule only, where the title sits: a sheen crossing it left to right.
// `y == 0` picks the rule out; the rest of the frame is left alone.

shaders {
    tint where="chrome" channel="fg" color="#ffffff" amount="(y == 0) * clamp(235 - abs(x - (t / 12 % cols)) * 40, 0, 235)"
}
