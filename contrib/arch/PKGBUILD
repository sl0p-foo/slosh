# Maintainer: Peter Geissler <peter@haxx.in>
#
# This file lives in contrib/arch/ in the slosh repo and is served raw at
# https://raw.githubusercontent.com/sl0p-foo/slosh/master/contrib/arch/PKGBUILD
# -- fetch it and
# makepkg -si. The same file feeds the self-hosted pacman repository at
# https://slosh.foo/arch/ (contrib/arch-repo builds it); it would also be the
# AUR package, but AUR signups are closed while the AUR deals with supply
# chain attacks, so self-hosting it is -- see contrib/arch/README.md.
#
# The build is offline-clean: the terminal core (libghostty-vt) is vendored
# in the tarball, and its zig dependencies are all lazy and unused by the
# VT-only build, so `zig build` fetches nothing. Verified against a cold
# ZIG_GLOBAL_CACHE_DIR.

pkgname=slosh
pkgver=0.1.2
pkgrel=1
pkgdesc="Terminal multiplexer: panes, tabs, and sessions you can detach from, on libghostty-vt"
arch=('x86_64' 'aarch64')
url="https://slosh.foo"
license=('MIT')
depends=('glibc')
# One package, no -debug split: this builds for a repo we host ourselves,
# and the stripped binary is the artifact.
options=('!debug')
# zig 0.16 specifically: the vendored core states minimum_zig_version 0.16.0,
# and a newer zig may well reject it -- zig is not yet stable across versions.
makedepends=('zig')
# GitHub's tag archive extracts to $pkgname-$pkgver/ (the v is stripped).
source=("$pkgname-v$pkgver.tar.gz::https://github.com/sl0p-foo/slosh/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a524d0668f8e9f197c6e27db277400b1877f60e897e76bee5d34f6e59f996d87')

# The Makefile's ZIG default is a developer-machine path; a builder has the
# real one. Overridable so the package can be test-built where zig lives
# elsewhere (ZIG=/path/to/zig makepkg).
_zig="${ZIG:-/usr/bin/zig}"

prepare() {
  cd "$pkgname-$pkgver"
  # A snapshot has no .git, so contrib/version falls back to ./VERSION -- and
  # in v0.1.1 that file was left at 0.1.0 (fixed since by contrib/release,
  # which bumps and tags as one step). Harmless for later tags: this writes
  # the number the file already holds.
  echo "$pkgver" > VERSION
}

build() {
  cd "$pkgname-$pkgver"
  # A hermetic zig cache: nothing under $HOME touched, nothing reused from it.
  export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-global-cache"
  make ZIG="$_zig" vendor
  make ZIG="$_zig" all
}

package() {
  cd "$pkgname-$pkgver"
  make ZIG="$_zig" DESTDIR="$pkgdir" PREFIX=/usr install
  # MIT, so the license ships with the package; THIRD-PARTY-LICENSES covers
  # what is statically linked in (libghostty-vt, stb_image).
  install -Dm644 LICENSE THIRD-PARTY-LICENSES -t "$pkgdir/usr/share/licenses/$pkgname"
}
