#!/usr/bin/env python3
"""A prompt for prototyping shader chains, run inside the pane it repaints.

    $ contrib/shader-repl
    chrome> tint color="#ff5fd7" amount="abs(t / 8 % 510 - 255)"
    ok
    chrome> :load sine-comet
    sine-comet.kdl: 1 chrome, 0 content
    chrome> :paste

The line you type is a chain in exactly the syntax `config.kdl` uses, sent to the
session with OSC 5577 and applied to *this* pane. Nothing is written anywhere, so
a chain you like has to be copied out -- which `:paste` does, in the form a config
file wants.

Needs `in_band_shaders true` in your config. Without it the session answers "off"
rather than doing it, which is the answer this asks for: a program restyling the
session it happens to be running in is a hazard, and prototyping is worth one line
of consent (D13).

Commands:
    :chrome     aim the next chain at the frame (the default)
    :content    aim it at the pane's contents
    :load F     a preset file: a path, or a name from `chrome/` or `shaders/`
                beside this script. Its entries go wherever their own `where=`
                says, so `:load sine-comet` fills the frame chain and
                `:load built-ins-spotlight` fills the contents one
    :clear      take this pane's chain away
    :both       clear both chains
    :paste      print what you have as a `shaders { }` block -- or, after a
                `:load`, the one `include` line that keeps it
    :help       this list
    :quit       leave (the chain stays until the pane closes)

`:load` hands the *path* to the session, which reads it with the parser that
already knows this format. Nothing here parses KDL: a second reader of a config
file is a second opinion about what it says, and comments and quoted strings are
exactly where those two would differ.

The prompt is readline's, so it has the editing and history you already know --
up/down through what you tried, ctrl-r to search it, and history kept across runs
in `$XDG_DATA_HOME/sl0ppty/shader-repl.history`. Tab completes the commands, the
shader names, the property keys and the expression language's own variables,
constants and functions -- and filenames after `:load`, which is most of what
there is to remember.

Python 3, standard library only.
"""
import atexit
import glob
import os
import select
import sys
import termios
import time
import tty

try:
    import readline
except ImportError:  # a python built without it: the prompt still works
    readline = None

OSC = "\033]5577;1;"
ST = "\033\\"
TIMEOUT = 2.0

COMMANDS = [":chrome", ":content", ":load", ":clear", ":both", ":paste",
            ":help", ":quit"]

# What there is to complete. Written here rather than asked for, because there is
# nothing to ask: the session has no verb that lists them. Kept honest by
# `tests/test_shader_repl.py`, which fails if `src/shader.c` or `src/expr.c`
# grows a name this list does not have -- a completion list that quietly goes
# stale is worse than none, because it reads as "that is all there is".
SHADERS = ["dim", "grayscale", "tint", "vignette", "gradient", "zebra", "ruler",
           "margin", "spotlight"]
PROPS = ["amount=", "color=", "channel=", "where=", "at=", "radius=", "band=",
         "direction="]
# Values worth offering: the two rects, the three channels.
VALUES = ['"chrome"', '"content"', '"fg"', '"bg"', '"both"']
VARS = ["x", "y", "cols", "rows", "curx", "cury", "cursor", "focused", "t",
        "since"]
# Angles are degrees, so pi is a half turn: `PI` is 180 and `TAU` is 360.
CONSTS = ["PI", "TAU"]
FUNCS = ["min(", "max(", "abs(", "clamp(", "dist(", "sin(", "cos("]

HISTORY = os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
    "sl0ppty", "shader-repl.history")


def complete(text, state):
    """One flat vocabulary -- except after `:load`, where the answer is filenames.

    A prompt that offers `amount=` where a path belongs is worse than one that
    offers nothing, and readline hands over the whole line, so telling the two
    apart costs one test. A shader name is only valid first and a variable only
    inside an expression, but a prompt that guesses which you meant and offers
    nothing when it guesses wrong is worse company than one that offers
    everything starting with what you typed."""
    line = readline.get_line_buffer() if readline else ""
    if line.lstrip().startswith(":load"):
        hits = []
        for pat in (text + "*", os.path.join(PRESET_DIRS[0], text + "*"),
                    os.path.join(PRESET_DIRS[1], text + "*")):
            for hit in sorted(glob.glob(pat)):
                # Bare names for the presets that ship here, real paths otherwise:
                # `:load sine-c<tab>` should finish the name, not spell out a
                # directory nobody typed.
                base = os.path.basename(hit)
                hits.append(hit + "/" if os.path.isdir(hit)
                            else (base if os.path.dirname(pat) != "" else hit))
        seen = []
        for hit in hits:
            if hit not in seen:
                seen.append(hit)
        return seen[state] if state < len(seen) else None

    words = COMMANDS + SHADERS + PROPS + VALUES + VARS + CONSTS + FUNCS
    hits = [w for w in words if w.startswith(text)]
    return hits[state] if state < len(hits) else None


def setup_readline():
    """Editing, history across runs, and tab completion. Nothing here is load
    bearing: without readline the prompt is still a prompt."""
    if not readline:
        return
    os.makedirs(os.path.dirname(HISTORY), exist_ok=True)
    try:
        readline.read_history_file(HISTORY)
    except OSError:
        pass  # first run, or a home directory we cannot read: not a reason to stop
    readline.set_history_length(500)
    atexit.register(write_history)
    readline.set_completer(complete)
    # `=`, `"` and `(` end a word: `color="#ff` should complete on `#ff`, and
    # `clamp(23` should not look like one enormous token.
    readline.set_completer_delims(' \t\n;=("')
    readline.parse_and_bind("tab: complete")


def write_history():
    try:
        readline.write_history_file(HISTORY)
    except OSError:
        pass  # a read-only home is not worth a traceback on the way out


def send(payload):
    sys.stdout.write(OSC + payload + ST)
    sys.stdout.flush()


def reply(fd, timeout=TIMEOUT):
    """One answer, read raw off the terminal.

    Replies carry no newline -- they are escape sequences, not lines -- so this
    reads bytes until the terminator rather than calling readline() and hanging.
    """
    out = ""
    deadline = time.monotonic() + timeout
    while True:
        left = deadline - time.monotonic()
        if left <= 0 or not select.select([fd], [], [], left)[0]:
            break
        out += os.read(fd, 256).decode("utf-8", "replace")
        if out.endswith(ST) or out.endswith("\a"):
            break
    if OSC + "shader-reply;" not in out:
        return None
    body = out.split(OSC + "shader-reply;", 1)[1]
    return body.rstrip(ST).rstrip("\a")


def ask(fd, where, chain):
    send("shader;%s;%s" % (where, chain))
    answer = reply(fd)
    if answer is None:
        # Whatever half-arrived is not a line anybody typed: drop it, or those
        # escape bytes become the front of the next thing readline reads.
        termios.tcflush(fd, termios.TCIFLUSH)
        return ("no answer -- is this pane inside sl0ppty?", False)
    if answer == "ok":
        return ("ok", True)
    return (answer.replace("error;", "", 1), False)


PRESET_DIRS = [os.path.join(os.path.dirname(os.path.abspath(__file__)), d)
               for d in ("chrome", "shaders")]


def resolve(arg):
    """A path, or the name of a preset that ships with sl0ppty.

    `:load contrib/chrome/sine-comet.kdl` and `:load sine-comet` are the same
    thing, the second one from any directory: the preset folders sit next to this
    script, so it can find them without being told where it was run from."""
    tries = [arg, arg + ".kdl"]
    for d in PRESET_DIRS:
        tries += [os.path.join(d, arg), os.path.join(d, arg + ".kdl")]
    for t in tries:
        if os.path.isfile(t):
            return os.path.abspath(t)
    return None


def load(fd, path):
    """Hand the session a file and let it do the reading.

    It has the parser -- comments, strings, `where=` routing, the lot -- and a
    second reader here would be a second opinion about what a preset says. So this
    resolves the name, makes the path absolute (the session's working directory is
    not ours) and sends it."""
    send("shader-load;%s" % path)
    answer = reply(fd)
    if answer is None:
        termios.tcflush(fd, termios.TCIFLUSH)
        return ("no answer -- is this pane inside sl0ppty?", False)
    if answer.startswith("ok"):
        _, _, detail = answer.partition(";")
        return (detail or "ok", True)
    return (answer.replace("error;", "", 1), False)


def paste(chains, loaded=None):
    """What a config file would say. Two `where=` entries rather than two blocks,
    because one `shaders { }` holds both and that is the shape to copy.

    After a `:load` the answer is one `include` line. The file is already on disk,
    already a `shaders { }` block and already commented -- reprinting thirty lines
    of it would scroll away the pane you are looking at, and rebuilding it from the
    chains would lose the comments that say what the effect is. `include` is the
    config's own way of saying "that file, as written".
    """
    if loaded:
        return '// %s\ninclude "%s"' % (os.path.basename(loaded), loaded)
    if not any(chains.values()):
        return "shaders { }  // nothing set"
    lines = ["shaders {"]
    for where, chain in chains.items():
        for entry in [e.strip() for e in chain.split(";") if e.strip()]:
            if "where=" in entry:
                lines.append("    %s" % entry)
            else:
                head, _, rest = entry.partition(" ")
                lines.append('    %s where="%s"%s'
                             % (head, where, (" " + rest) if rest else ""))
    lines.append("}")
    return "\n".join(lines)


def main():
    if not sys.stdin.isatty():
        sys.exit("shader-repl: needs a terminal (run it in a pane)")
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    where = "chrome"
    chains = {"chrome": "", "content": ""}
    loaded = None  # the preset file in force, for `:paste`

    setup_readline()
    print("shader-repl: a chain in config syntax, applied to this pane.")
    print("  " + "  ".join(COMMANDS) + ("" if readline else "   (no readline)"))
    try:
        while True:
            try:
                line = input("%s> " % where)
            except EOFError:
                break
            line = line.strip()
            if not line:
                continue
            # History is for chains. `:quit` and `:paste` are how you drove the
            # prompt, not what you were working on, and having to press up past
            # four of them to reach the line you want to edit is the whole
            # annoyance history exists to remove.
            if line.startswith((":", "?")) and readline:
                n = readline.get_current_history_length()
                if n:
                    readline.remove_history_item(n - 1)

            if line in (":quit", ":q"):
                break
            if line in (":chrome", ":content"):
                where = line[1:]
                continue
            if line == ":paste":
                print(paste(chains, loaded))
                continue
            if line.startswith(":load"):
                arg = line[len(":load"):].strip()
                if not arg:
                    print("  :load <file.kdl>, or the name of one in chrome/ or "
                          "shaders/ beside this script")
                    continue
                path = resolve(arg)
                if not path:
                    print("  no such file: %s" % arg)
                    continue
                tty.setraw(fd)
                try:
                    msg, ok = load(fd, path)
                finally:
                    termios.tcsetattr(fd, termios.TCSADRAIN, saved)
                if ok:
                    # The file replaces both chains, so the typed ones are gone
                    # and `:paste` should answer with the file rather than with
                    # something half true.
                    loaded = path
                    chains["chrome"] = chains["content"] = ""
                print("  %s: %s" % (os.path.basename(path), msg))
                continue
            if line in (":help", ":h", "?"):
                print("  " + "  ".join(COMMANDS))
                print("  shaders: " + " ".join(SHADERS))
                print("  keys:    " + " ".join(p.rstrip("=") for p in PROPS))
                print("  vars:    " + " ".join(VARS))
                print("  consts:  " + " ".join(CONSTS)
                      + "   (degrees, so PI is a half turn)")
                print("  funcs:   " + " ".join(f.rstrip("(") for f in FUNCS))
                print("  :load takes a path, or a preset name from chrome/ or shaders/")
                print("  tab completes all of it; up/down and ctrl-r are history")
                continue
            if line in (":clear", ":both"):
                # `:both` names no rect, which the session reads as all of them:
                # one exchange, and the pane cannot be left half put-back.
                target = "" if line == ":both" else where
                tty.setraw(fd)
                try:
                    msg, ok = ask(fd, target, "")
                finally:
                    termios.tcsetattr(fd, termios.TCSADRAIN, saved)
                if ok:
                    loaded = None
                    if target:
                        chains[target] = ""
                    else:
                        chains["chrome"] = chains["content"] = ""
                print(msg)
                continue

            # raw only around the exchange, so the prompt keeps its line editing
            tty.setraw(fd)
            try:
                msg, ok = ask(fd, where, line)
            finally:
                termios.tcsetattr(fd, termios.TCSADRAIN, saved)
            if ok:
                chains[where] = line
                loaded = None  # hand-typed now: `:paste` should say so
            print(msg)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


if __name__ == "__main__":
    main()
