// sl0p -- the default: hot pink on near-black
//
// Drop into ~/.config/sl0ppty/config.kdl, or point $SL0PPTY_CONFIG at a file
// that contains it. A running session re-reads it the moment you save.
theme {
    // what a shader takes "terminal default" to mean
    default_fg "#ffffff"
    default_bg "#000000"

    // panes
    frame_focus "#ff5fd7"
    frame_idle "#45454a"
    title "#ffffff"
    title_idle "#45454a"

    // a pane's own OSC 5577 buttons
    button_fg "#141418"
    button_bg "#ff5fd7"
    button_bg_idle "#45454a"

    // affordances under the pointer
    guide "#ff5fd7"
    resize "#ff5fd7"
    drop_target "#ff5fd7"

    // scrollback indicator
    scroll_fg "#141418"
    scroll_bg "#ff5fd7"

    // rows of a tab collapsed into a list
    header "#45454a"
    header_hover "#ff5fd7"
    header_hover_title "#ffffff"

    // the strip along the top
    tab_active_fg "#141418"
    tab_active_bg "#ff5fd7"
    tab_active_hover_fg "#ffffff"
    tab_idle "#45454a"
    tab_hover "#ff5fd7"
    prefix_fg "#141418"
    prefix_bg "#ff5fd7"
    tab_count "#45454a"

    // the line along the bottom
    status "#45454a"
    status_state "#ffffff"
    hint "#ffffff"

    // the pane finder
    finder_fg "#ffffff"
    finder_bg "#45454a"
    finder_sel_fg "#141418"
    finder_sel_bg "#ff5fd7"

    // rename editor, bell, dead panes, frame buttons, the minimised bar
    rename_fg "#141418"
    rename_bg "#ff5fd7"
    toast_fg "#141418"
    toast_bg "#ff5fd7"
    bell "#ff5fd7"
    dead "#ff875f"
    pane_button "#45454a"
    pane_button_hover "#ff5fd7"
    minbar "#45454a"
    minbar_hover "#ff5fd7"

    // a modal floating over the layout (the cheatsheet, C-a ?)
    modal_bg "#1c1c22"
    modal_fg "#e8e8ea"
    modal_border "#ff5fd7"
    modal_title "#ffffff"
    modal_button "#8a8a95"
    modal_button_hover "#ff5fd7"
}
