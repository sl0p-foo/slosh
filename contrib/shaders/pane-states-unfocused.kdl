// unfocused — pane states
//
// Generated from contrib/shadertoy.html by contrib/gen-shaders; edit the
// preset there, where you can see what it does, and run that again.
//
// Drop this into ~/.config/slosh/config.kdl (a running session picks it up
// when you save), or point $SLOSH_CONFIG at this file. To hang it off a
// pane state instead of every pane, put the same passes inside one:
//
//     states { unfocused { ... } }

shaders {
    dim amount="90"
}
