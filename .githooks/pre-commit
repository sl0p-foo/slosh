#!/bin/sh
# Format the C being committed, so what lands in git is already formatted.
#
# Install with `make hooks`, which points `core.hooksPath` here. Hooks are not
# versioned by git, so a hook in a repo has to be a file somebody opts into --
# there is no way to ship one that runs on clone, and a repo that could would be
# a repo that runs code on clone.
#
# Skip a commit with `git commit --no-verify` when you mean to.
set -e

# Only what is staged, only C, and never the vendored tree: libghostty-vt is
# somebody else's code, pinned by commit (D12), and reformatting it would turn
# every future re-vendor into a merge.
files=$(git diff --cached --name-only --diff-filter=ACMR \
        | grep -E '\.[ch]$' | grep -v '^vendor/' || true)
[ -n "$files" ] || exit 0

if ! command -v clang-format >/dev/null 2>&1; then
  echo "pre-commit: clang-format is not installed, and this commit touches C." >&2
  echo "  install it (apt install clang-format / brew install clang-format)," >&2
  echo "  or commit with --no-verify if you know what you are doing." >&2
  exit 1
fi

# A file with unstaged changes is the one case where formatting in place is
# dangerous: `clang-format -i` rewrites the *working tree*, and re-staging it
# would commit work that was deliberately left out of the index. So say so and
# stop, rather than quietly widening the commit somebody carefully built with
# `git add -p`.
partial=""
for f in $files; do
  if ! git diff --quiet -- "$f"; then partial="$partial $f"; fi
done
if [ -n "$partial" ]; then
  echo "pre-commit: these files are only partly staged, so formatting them" >&2
  echo "  in place would add work you left out of the commit:" >&2
  for f in $partial; do echo "    $f" >&2; done
  echo "  stage them fully, stash the rest, or use --no-verify." >&2
  exit 1
fi

clang-format -i $files
git add -- $files

# Nothing is left to check: the files are formatted and staged. Said out loud
# because a hook that changes your commit and does not mention it is a hook
# people learn to distrust.
changed=$(git diff --cached --name-only -- $files | tr '\n' ' ')
[ -n "$changed" ] && echo "pre-commit: formatted$(printf '%s' " $changed" | sed 's/ *$//')"
exit 0
