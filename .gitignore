# Anchored to the repo root: this is slosh's own build output. An unanchored
# `build/` also matches nested dirs like vendor/libghostty-vt/src/build/, which
# silently dropped the vendored library's build tooling from git and broke
# `make vendor` on fresh clones.
/build/
.scratch/
vendor/libghostty-vt/zig-out/
# one per cross-compiled Windows arch (Makefile.windows)
vendor/libghostty-vt/zig-out-win-*/
*.obj
vendor/libghostty-vt/.zig-cache/
vendor/libghostty-vt/zig-pkg/
__pycache__/

# built plugins
*.so

# the formatter venv (make tools). Modern python writes .venv/.gitignore too,
# but not every version does, and the intent belongs in our file.
.venv/

# the landing-page preview video (large binary, lives outside git)
web/slosh-preview.mp4

# the signed macOS artifacts, and the file that says who signs them.
# The release *mechanism* is in the repo (Makefile.macos, contrib/macos-*).
# macos-release.mk is the one file that is not: it names a team, a certificate
# and a builder machine, which belong to whoever is releasing rather than to
# the project. macos-release.mk.example is the template, and is tracked.
/dist/
macos-release.mk

# Local dev tooling state, not part of the project: the per-repo speed cache,
# and a scratch design doc.
.fastfeedback/
/DESIGN.md
