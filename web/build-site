#!/bin/sh
# Assemble the whole website into build/www:
#
#     /            web/             the front page (this directory)
#     /docs/       contrib/gen-docs the rendered documentation
#     /demo/       web/demo/        the in-browser machine, on its own page
#
#     web/build-site               everything (or: make www)
#     NO_DEMO=1 web/build-site     skip the demo (it cross-compiles a
#                                  guest and needs zig + e2fsprogs)
#
# The output is only static files. Serve it with anything that serves a
# directory; the one condition is .wasm as application/wasm, which
# `web/demo/serve --dir build/www` handles locally.

set -eu

here="$(cd "$(dirname "$0")" && pwd)"
root="$(dirname "$here")"
www="$root/build/www"

# Assemble into a staging directory and swap at the end: a build that fails
# halfway (set -eu) must not have already deleted the site that worked.
out="$root/build/.www-staging"
rm -rf "$out"
mkdir -p "$out"

publish() {
    rm -rf "$www"
    mv "$out" "$www"
}

# For now slosh.foo is a coming-soon page; the full site is assembled only
# when asked (FULL=1) while it is being finished.
if [ "${FULL:-0}" != 1 ]; then
    cp "$here/coming-soon.html" "$out/index.html"
    publish
    echo "build-site: $www (coming soon -- FULL=1 for the real site)"
    exit 0
fi

# The front page. Its recordings are below; there is no video.
cp "$here/index.html" "$here/site.css" "$here/install.sh" "$out/"

# The docs, rendered by the same generator `make docs` uses.
python3 "$root/contrib/gen-docs" "$out/docs"

# The recordings: scripted feature playbacks (see recordings/PLAN.md),
# re-rendered from their driver scripts so they can never be stale.
make -C "$here/recordings"
mkdir -p "$out/recordings"
cp "$here/recordings/build/"*.json \
   "$here/recordings/player.js" "$here/recordings/player.css" \
   "$out/recordings/"

# The demo, assembled by its own Makefile, on its own page.
if [ "${NO_DEMO:-0}" = 1 ]; then
    echo "build-site: skipping demo (NO_DEMO=1)"
else
    make -C "$here/demo" site
    mkdir -p "$out/demo"
    cp -R "$here/demo/build/site/." "$out/demo/"
fi

publish
echo "build-site: $www"
echo "build-site: serve with: web/demo/serve --dir build/www"
