--- a/riscv_cpu.c
+++ b/riscv_cpu.c
@@ -600,9 +600,17 @@
     tlb_init(s);
 }
 
+/* `sfence.vma rs1` names one page, and the three TLBs are direct-mapped on the
+ * page number, so that page's translation can only ever live at one index in
+ * each of them: clearing those three entries is complete. The original flushed
+ * all 768 entries, which Linux pays for on every unmap - and it unmaps
+ * constantly, on every fork, exec and munmap. */
 static void tlb_flush_vaddr(RISCVCPUState *s, target_ulong vaddr)
 {
-    tlb_flush_all(s);
+    int i = (vaddr >> PG_SHIFT) & (TLB_SIZE - 1);
+    s->tlb_read[i].vaddr = -1;
+    s->tlb_write[i].vaddr = -1;
+    s->tlb_code[i].vaddr = -1;
 }
 
 /* XXX: inefficient but not critical as long as it is seldom used */
